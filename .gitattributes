# Define macros (only works in top-level gitattributes files)
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Optionally collapse Unity YAML files on GitHub diffs
# [attr]unity-yaml        merge=unityyamlmerge text linguist-language=yaml linguist-generated

# Unity source files
# eol=lf is forced on every authored text family so a Windows teammate with
# core.autocrlf=true cannot turn a whole-file diff into a line-ending churn.
*.cginc                 text eol=lf
*.compute               text eol=lf linguist-language=hlsl
*.cs                    text eol=lf diff=csharp
*.hlsl                  text eol=lf linguist-language=hlsl
*.raytrace              text eol=lf linguist-language=hlsl
*.shader                text eol=lf
*.md                    text eol=lf
*.json                  text eol=lf

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json text eol=lf
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml

# "physic" for 3D but "physics" for 2D
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

# Exclude from GitHub stats and diffs: third-party plugins, packages lock file
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

# Unity LFS
# NEVER add *.asset / *.unity / *.prefab / *.meta here. They are YAML text that
# Unity parses on import; an LFS pointer committed as one of them is imported as
# a broken asset on any machine without git-lfs, and Unity Smart Merge cannot
# merge pointers. The `lfs` macro below is for binaries only.
*.cubemap               lfs
*.unitypackage          lfs

